{
  "manifest_version": 3,
  "name": "Robô Android Reativo",
  "version": "1.0.0",
  "description": "O Robô Android lê a mensagem do assistente na página, sente a reação dela e a repete falado em um balão, animando o corpo conforme o humor da mensagem.",
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Robô Android Reativo",
    "default_popup": "src/popup.html"
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/robot.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
